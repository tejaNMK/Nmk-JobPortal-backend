DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/nmk_jobportal

# ========================================================
# SQLAlchemy async database connection pool.
# Total possible DB connections =
# app_instances * workers_per_instance * (DB_POOL_SIZE + DB_MAX_OVERFLOW).
# Keep this below PostgreSQL max_connections with headroom for migrations,
# monitoring, admin sessions, and other services.
# ========================================================
# Number of persistent DB connections kept per app worker process.
DB_POOL_SIZE=10
# Temporary overflow connections allowed per app worker during bursts.
DB_MAX_OVERFLOW=5
# Seconds a request waits for an available connection before failing.
DB_POOL_TIMEOUT_SECONDS=10
# Seconds before a pooled connection is recycled to avoid stale long-lived DB connections.
DB_POOL_RECYCLE_SECONDS=1800
# Validate pooled connections before use so stale connections are replaced safely.
DB_POOL_PRE_PING=true
# Seconds allowed when opening a new DB connection.
DB_CONNECT_TIMEOUT_SECONDS=10
# Seconds allowed for an asyncpg command/query before timing out.
DB_COMMAND_TIMEOUT_SECONDS=30

JWT_SECRET_KEY=replace-with-output-of-python-secrets-token-urlsafe-64
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Environment name controls whether localhost CORS origins are permitted.
# Use "production" for deployed environments.
APP_ENV=development

# Comma-separated trusted browser origins. Do not use "*".
# Production example:
# APP_ENV=production
# CORS_ALLOWED_ORIGINS=https://production-frontend-domain.com
#
# Development example:
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Keep false for Bearer-token APIs unless the frontend sends cookies or other
# browser credentials. Never combine credentials with wildcard origins.
CORS_ALLOW_CREDENTIALS=false

# ========================================================
# Authentication rate limiting.
# Use Redis in production so limits are shared across workers/instances.
# ========================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORAGE_URL=redis://localhost:6379/0
RATE_LIMIT_TRUSTED_PROXY_IPS=127.0.0.1
RATE_LIMIT_REAL_IP_HEADER=X-Forwarded-For

# ========================================================
# Sentry error tracking is disabled unless SENTRY_DSN is set.
# ========================================================
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=

# Cloudflare Turnstile CAPTCHA.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ========================================================
# AWS credentials and Bedrock AI provider.
# IAM principal must be allowed to call bedrock:Converse for BEDROCK_MODEL_ID.
# BEDROCK_ACCESS_KEY_ID / BEDROCK_SECRET_ACCESS_KEY / BEDROCK_SESSION_TOKEN
# are optional dedicated Bedrock credentials and take precedence over shared
# AWS_* credentials when set.
# BEDROCK_REGION can differ from AWS_REGION if your Bedrock model is enabled
# in a different AWS region.
# ========================================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
BEDROCK_ACCESS_KEY_ID=
BEDROCK_SECRET_ACCESS_KEY=
BEDROCK_SESSION_TOKEN=
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_TIMEOUT_SECONDS=30
BEDROCK_MAX_OUTPUT_CHARS=12000
BEDROCK_MAX_TOKENS=4000
BEDROCK_RATE_LIMIT_PER_MINUTE=10

# ========================================================
# AI Job Description provider abstraction.
# Supported AI_PROVIDER values: bedrock, openai, azure_openai, anthropic,
# gemini, deepseek. Bedrock remains the default for backward compatibility.
# Use Redis for production caching; memory:// is suitable for local only.
# ========================================================
AI_PROVIDER=bedrock
AI_MODEL=
AI_TIMEOUT_SECONDS=30
AI_RETRY_ATTEMPTS=3
AI_JOB_DESCRIPTION_CACHE_URL=redis://localhost:6379/1
AI_JOB_DESCRIPTION_CACHE_TTL_SECONDS=86400
AI_COST_INPUT_PER_MILLION_USD=0
AI_COST_OUTPUT_PER_MILLION_USD=0

OPENAI_API_KEY=
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

GOOGLE_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_BASE_URL=
AZURE_OPENAI_MODEL=gpt-4.1

# ========================================================
# Structured JSON logging
# ========================================================
SERVICE_NAME=nmk-jobportal-userservice
LOG_ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_EXCLUDED_PATHS=/health,/docs,/redoc,/openapi.json
CLOUDWATCH_LOGGING_ENABLED=false
CLOUDWATCH_LOG_GROUP=/nmk/jobportal/userservice
CLOUDWATCH_LOG_STREAM=
CLOUDWATCH_LOG_RETENTION_DAYS=30

# Generate a real local/production JWT secret with:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
